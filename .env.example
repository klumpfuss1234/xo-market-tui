# XO TUI starts read-only when these values are blank.
# Copy this file to .env, run `chmod 600 .env`, then add only your own values.
# Never commit, paste, screenshot, or share the completed .env file.

XO_TUI_SMART_ACCOUNT=
XO_TUI_OWNER_PRIVATE_KEY=
XO_TUI_API_KEY=
XO_TUI_API_SECRET=
XO_TUI_API_PASSPHRASE=

# XO live compatibility default. Change only if XO documents a different mode.
XO_TUI_HMAC_MODE=path-only
